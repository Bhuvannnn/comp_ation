# Copy to .env locally. Never commit .env.

# --- Paid OpenAI (optional) ---
# OPENAI_API_KEY=
# DISCOVERY_MODEL=gpt-5.6-terra
# DISCOVERY_MAX_USD=2.00

# --- Free local path: Ollama (no account) ---
# brew install ollama && ollama serve && ollama pull qwen2.5:3b
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
DISCOVERY_MODEL=qwen2.5:3b

# --- Free hosted path: Groq (free account, usually no credit card) ---
# https://console.groq.com/keys
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# DISCOVERY_MODEL=llama-3.3-70b-versatile

# MemberDesk fixture
MEMBERDESK_HOST=127.0.0.1
MEMBERDESK_PORT=4173

# Headed Chromium for optional HITL demo. Tests and CI stay headless.
HEADED=0
