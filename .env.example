# Copy to .env locally. Never commit .env.

# Required only for a live discovery evidence run (Project.md §4).
OPENAI_API_KEY=

# Discovery model. Default is gpt-5.6-terra (orchestrator lock G6).
DISCOVERY_MODEL=gpt-5.6-terra

# Hard stop if estimated spend exceeds this (USD) for one discover run.
DISCOVERY_MAX_USD=2.00

# MemberDesk fixture
MEMBERDESK_HOST=127.0.0.1
MEMBERDESK_PORT=4173

# Headed Chromium for optional HITL demo. Tests and CI stay headless.
HEADED=0
